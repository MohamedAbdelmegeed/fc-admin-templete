# ═══════════════════════════════════════════════════════════════
#  قالب لوحة التحكم — كود المستقبل
#  أي مفتاح جديد في .env لازم يتضاف هنا في نفس الـ commit. (docs/00 بند ٤)
# ═══════════════════════════════════════════════════════════════

APP_NAME="Future Code Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8443
APP_VERSION=1.0.0

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG
APP_TIMEZONE=Africa/Cairo
APP_SUPPORTED_LOCALES=ar,en
APP_CURRENCY=EGP

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ─────────────── قاعدة البيانات ───────────────
# Postgres مش SQLite — حتى في الاختبارات. (docs/17 بند ١)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fc_admin
DB_USERNAME=fc
DB_PASSWORD=secret

# ─────────────── Redis ───────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ─────────────── الجلسات ───────────────
# database مش redis: عشان نقدر نمسح جلسة جهاز معيّن. (docs/12 بند ٢)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# محلياً false — في الإنتاج true إلزامي. (docs/20 بند ٩)
SESSION_SECURE_COOKIE=false

# ─────────────── البث ───────────────
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ─────────────── التخزين ───────────────
# MinIO بيحاكي S3 محلياً — بنجرّب S3 من يوم ١. (docs/00 بند ١)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fc-admin
# باكت منفصل للملفات الخاصة — من غير سياسة anonymous.
# لو اتساب فاضي بيرجع لـ AWS_BUCKET، والملفات الخاصة تبقى عامة.
AWS_PRIVATE_BUCKET=fc-admin-private
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/fc-admin
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─────────────── البريد ───────────────
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="admin@fc-admin.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────── اللوجينج ───────────────
# في الإنتاج: LOG_STACK=json,stderr,sentry
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# ─────────────── التفويض والصلاحيات ───────────────
PERMISSION_CACHE_TTL="24 hours"
PERMISSION_CACHE_STORE=redis
# الدور اللي بياخده منشئ المؤسسة جواها (المدير العام مستثنى)
AUTH_TENANT_CREATOR_ROLE=admin

# ─────────────── الإعدادات الديناميكية ───────────────
# لازم مفعّل: من غيره DynamicConfigServiceProvider بيستعلم في كل طلب.
SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_STORE=redis

# ─────────────── الأمان ───────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
IMPERSONATION_MAX_MINUTES=30
# ابدأ بوضع التقرير، وحوّل للفرض بعد ما المخالفات تنضف. (docs/20 بند ٥)
CSP_ENABLED=true
CSP_ENFORCE=false
# في الإنتاج: قائمة CIDR صريحة مش '*'. (docs/14 بند ١)
TRUSTED_PROXIES=*

# ─────────────── الإشعارات ───────────────
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_PRUNE_DAYS=90

# ─────────────── المراقبة ───────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
TELESCOPE_ENABLED=true
PULSE_ENABLED=true

# ─────────────── النسخ الاحتياطي ───────────────
BACKUP_ALERT_EMAIL=
